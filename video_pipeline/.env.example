# ── Idea Generation ────────────────────────────────────────────────────────────
IDEA_PROVIDER=grok            # "grok" (default) or "claude"

# xAI / Grok  →  console.x.ai
XAI_API_KEY=xai-...
GROK_MODEL=grok-3             # or grok-3-mini for faster/cheaper

# Anthropic / Claude  →  console.anthropic.com  (only needed if IDEA_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# ── Video Generation (choose one provider) ─────────────────────────────────────
VIDEO_PROVIDER=kling          # "kling" or "runway"

# Kling AI
KLING_API_KEY=your-kling-api-key
KLING_API_SECRET=your-kling-api-secret

# Runway ML (alternative)
RUNWAY_API_KEY=your-runway-api-key

# ── TikTok (Content Posting API v2) ────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_OPEN_ID=your-tiktok-open-id

# ── Instagram (Graph API) ──────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# ── Pipeline Config ────────────────────────────────────────────────────────────
VIDEO_DURATION=15             # seconds per clip
IDEAS_PER_RUN=10              # concepts to generate per run
OUTPUT_DIR=output
ASSETS_DIR=assets
DB_PATH=pipeline.db           # SQLite database path

# Set to "true" to run without making real API calls or uploads
DRY_RUN=false

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Comma-separated 24h times in local timezone
POST_TIMES=14:00
POSTS_PER_DAY=1
